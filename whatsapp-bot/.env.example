# Copy to .env (or export in your shell) before `npm start`
AGENT_NAME=Your Name, OIC Agent
MERGE_WAIT_SECONDS=45
REPLY_IN_GROUPS=0
# Which groups to answer in (exact group names, comma-separated). Empty = all groups.
# The bot prints your group names when it starts.
ALLOW_GROUPS=
# Only auto-reply to these numbers (country code + number, digits only). Empty = everyone.
ALLOW_NUMBERS=
# Automatic quotes from one-line requests: 1 = on, 0 = off (default off)
AUTO_QUOTE=0
# If a quote request lacks details: 0 = say nothing to the customer and notify you
# in your own chat (default), 1 = ask the customer for the missing details.
ASK_FOR_MISSING=0
AUTO_PDF=1
# Make a PDF only when a set has at least this many photos (single images are ignored)
MIN_PHOTOS=3

# How many days of missed messages to catch up on after the laptop was off (default 3)
CATCH_UP_DAYS=3
# Where the merged photo PDF is sent: me (your own chat, default), sender, or both
PDF_TO=me
# INBOX_DIR=/path/to/inbox
# Where merged PDFs are filed as <year>/<year-month Month>/<date>/<file>.pdf
# Default: the 'merged' folder inside whatsapp-bot. Example: MERGED_DIR=D:\WhatsApp PDFs
# MERGED_DIR=
# Read the vehicle number from the photos (local OCR, free) and name the file
# <VEHICLE>_<date>.pdf. 0 = off (name by sender instead).
OCR_VEHICLE=1
# Which calculator to price with: a file path or a URL. If empty, the bot uses
# ../index.html when present, otherwise the live site below.
# CALCULATOR_HTML=https://nvkoicl.github.io/PREMIUM-CALCULATOR/
# Pin a specific WhatsApp Web build only if told to (normally leave unset).
# WA_WEB_VERSION=

# --- Email a copy of every merged PDF (optional) ---
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below.
EMAIL_TO=
EMAIL_FROM=
EMAIL_APP_PASSWORD=

# --- Supervisor (node run.js) ---
# Check GitHub for a new bot version every N minutes and install it automatically
UPDATE_CHECK_MINUTES=30
AUTO_UPDATE=1

# --- Private status/QR web page (for a cloud server with no screen) ---
# http://<server-ip>:<port>/<token>/   Leave empty on a laptop.
STATUS_PORT=
STATUS_TOKEN=

# --- Send policy PDFs back to whoever sent the vehicle photos ---
# New PDFs in the bot's outbox/ folder are always offered. Set 1 to also watch your Downloads folder.
WATCH_DOWNLOADS=1
# DOWNLOADS_DIR=C:\Users\dell\Downloads
# 1 = send automatically to the private sender without asking (default: ask in your own chat)
DISPATCH_AUTO=0

# --- Watch Gmail for policy PDFs and dispatch them (laptop must be on) ---
MAIL_WATCH=0
# Uses EMAIL_FROM / EMAIL_APP_PASSWORD unless these are set:
# MAIL_WATCH_USER=
# MAIL_WATCH_PASSWORD=
# Only mails from these senders (comma-separated, partial match). Empty = any sender with a PDF.
MAIL_WATCH_FROM=
# Subject must contain this word (optional)
MAIL_WATCH_SUBJECT=
MAIL_WATCH_MINUTES=1

# --- Renewal reminders (put your renewals.xlsx in this folder) ---
# Automatic reminders this many days before expiry (each policy once per milestone; 0 = on the day)
RENEWAL_MILESTONES=10,7,3,1
# Time of day (24h) to send them
RENEWAL_HOUR=8
# Window for the manual 'due' command
RENEWAL_DAYS=2

# Vehicle-number reading: auto (built-in first, PaddleOCR when it finds nothing),
# paddle (PaddleOCR first), or tesseract (built-in only)
OCR_ENGINE=auto
